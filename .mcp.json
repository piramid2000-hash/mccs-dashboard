{
  "mcpServers": {
    "korean-patent": {
      "type": "stdio",
      "command": "node",
      "args": ["${HOME}/.seion-mcp/korean-patent-mcp/build/index.js"],
      "env": {
        "KIPRIS_API_KEY": "${KIPRIS_KEY:-}"
      }
    },
    "kordoc": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "kordoc@4.25.22", "mcp"],
      "env": {
        "KORDOC_OFFLINE": "1"
      }
    }
  }
}
